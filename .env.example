# Local SQLite development
NODE_ENV=development
HOST=127.0.0.1
PORT=3100
BASE_URL=http://127.0.0.1:3100
DATABASE_PATH=./data/store.sqlite
PAYMENT_ADAPTER=disabled
EMAIL_ADAPTER=development
# Vercel server-side configuration
SUPABASE_URL=https://yapvpsuzikhrmftiolgj.supabase.co
SUPABASE_ANON_KEY=
SITE_ORIGIN=https://shopwithoreva.ng
# Paystack secret key. Start with sk_test_...; switch to sk_live_... only when ready for real charges.
# Keep this server-only in Vercel. Never expose it in browser code.
PAYSTACK_SECRET_KEY=
# Server-only Vercel variable. Never expose in browser code or commit its value.
SUPABASE_SERVICE_ROLE_KEY=
# Transactional order confirmation email (server-only).
RESEND_API_KEY=
# Verified sender on your Resend domain, for example:
# Orẽva <orders@shopwithoreva.ng>
EMAIL_FROM=

# Leave this EMPTY after shopwithoreva.ng is verified in Resend.
# Setting it restricts customer receipts to only that one test address.
EMAIL_TEST_RECIPIENT=

# Owner email for separate verified-payment order alerts.
OWNER_NOTIFICATION_EMAIL=
